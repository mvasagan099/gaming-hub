NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://gaming:gaming@localhost:5540/gaming_hub?connection_limit=20&pool_timeout=30
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
INTERNAL_API_KEY=generate-a-long-random-secret-min-16-chars
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=300
LOG_LEVEL=info
# Max accepted JSON body size in bytes (default 262144 = 256 KiB)
BODY_LIMIT=262144
# Reject access tokens whose email is unverified. Defaults to true in production.
REQUIRE_EMAIL_VERIFICATION=true

# Database connection pool settings
DB_CONNECTION_LIMIT=20

# Optional Redis connection for multi-node setups and caching
REDIS_URL=

# Production Email Service (Choose: "brevo" | "sendgrid" | "smtp" | "ses" | "mock")
EMAIL_PROVIDER=mock

# Brevo HTTP API Configuration (Primary Production Provider, works on Render Free/Paid)
# Uses POST https://api.brevo.com/v3/smtp/email over HTTPS (port 443)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=youraddress@yourdomain.com
BREVO_FROM_NAME=Gaming Hub

# SendGrid Configuration (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@yourdomain.com

# SMTP / Gmail Configuration (when EMAIL_PROVIDER=smtp)
# For Gmail: use smtp.gmail.com, port 587, STARTTLS (SMTP_SECURE=false).
# SMTP_PASS must be a Gmail App Password, NOT your regular Gmail password.
# Enable App Passwords at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youraddress@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# EMAIL_FROM: verified sender address shown in email "From" header
EMAIL_FROM=youraddress@gmail.com
# SMTP_FROM is a legacy alias for EMAIL_FROM (kept for backward compatibility)
SMTP_FROM=noreply@yourdomain.com
