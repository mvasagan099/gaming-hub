generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  CUSTOM
}

enum RankTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  MASTER
  GRANDMASTER
  LEGEND
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum PenaltyType {
  AFK_WARNING
  AFK_PENALTY
  RAGE_QUIT
  DISCONNECT_TIMEOUT
  CHEATING
  ABUSE
  SPAMMING
  UNSPORTSMANLIKE_CONDUCT
}

enum PenaltyStatus {
  ACTIVE
  EXPIRED
  APPEALED
  REVOKED
}

enum GameNotificationType {
  MATCH_FOUND
  MATCH_STARTING
  MATCH_ENDED
  RANK_CHANGED
  ACHIEVEMENT_UNLOCKED
  SEASON_REWARD
  FRIEND_ONLINE
  TOURNAMENT_STARTING
  PENALTY_RECEIVED
  APPEAL_RESOLVED
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum RoomStatus {
  WAITING
  STARTING
  PLAYING
  ENDED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  RECONNECTING
}

enum MatchStatus {
  CREATED
  ACTIVE
  FINISHED
  ABORTED
}

enum MatchPlayerResult {
  PENDING
  WIN
  LOSS
  DRAW
}

enum TransactionType {
  CREDIT
  DEBIT
  ADJUST
}

enum TransactionReferenceType {
  MATCH_WAGER
  MATCH_PAYOUT
  ADMIN
  BONUS
  PRACTICE
  DEPOSIT
  WITHDRAWAL
  REFERRAL
  COUPON
  TOURNAMENT_ENTRY
  TOURNAMENT_PRIZE
  LOCKED_CREDIT
  REWARD_CREDIT
  CASHBACK_CREDIT
  WAGER_REFUND
  REVERSAL
}

enum NotificationType {
  MATCH_INVITE
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  MATCH_RESULT
  TOURNAMENT
  SYSTEM
  REFERRAL
  COUPON
  ANNOUNCEMENT
  MESSAGE
  SUPPORT
  PROMOTION
  WALLET
  ACHIEVEMENT
  SYSTEM_ALERT
}

enum TournamentStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum TournamentFormat {
  BRACKET
  KNOCKOUT
  ROUND_ROBIN
  SWISS
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum WalletRequestKind {
  DEPOSIT
  WITHDRAWAL
}

enum WalletRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AnnouncementType {
  INFO
  UPDATE
  MAINTENANCE
  PROMOTION
  ALERT
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CronJobStatus {
  SUCCESS
  FAILED
  RUNNING
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  IGNORED
}

model User {
  id           String    @id
  email        String?   @unique
  username     String    @unique
  displayName  String
  avatarUrl    String?
  role         UserRole  @default(USER)
  customRoleId String?
  referralCode String?   @unique
  isOnline     Boolean   @default(false)
  lastSeenAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile            Profile?
  wallet             Wallet?
  playerStatistics   PlayerStatistic[]
  gameStats          PlayerGameStats[]
  competitiveRanks   CompetitiveRank[]
  penalties          PlayerPenalty[]
  reputation         PlayerReputation?
  reportsMade        PlayerReport[]     @relation("ReportedBy")
  reportsReceived    PlayerReport[]     @relation("ReportedUser")
  gameNotifications  GameNotification[]
  
  leaderboards       Leaderboard[]
  friendsRequested   Friend[]             @relation("FriendRequester")
  friendsReceived    Friend[]             @relation("FriendAddressee")
  blockedBy          BlockedUser[]        @relation("BlockedBy")
  blocking           BlockedUser[]        @relation("BlockingUser")
  roomsOwned         Room[]               @relation("RoomHost")
  roomPlayers        RoomPlayer[]
  matchPlayers       MatchPlayer[]
  moves              Move[]
  walletTransactions Transaction[]
  notifications      AppNotification[]
  chatMessages       ChatMessage[]
  userAchievements   UserAchievement[]
  tournamentPlayers  TournamentPlayer[]
  referralsMade      Referral[]           @relation("Referrer")
  referralsReceived  Referral[]           @relation("ReferredUser")
  couponRedemptions  CouponRedemption[]
  walletRequests     WalletRequest[]
  walletRequestDecisions WalletRequest[]    @relation("WalletRequestAdmin")
  walletOtps         WalletOtp[]
  conversations      ConversationMember[]
  sentMessages       Message[]
  searchHistory      SearchHistory[]
  supportTickets     SupportTicket[]
  ticketMessages     TicketMessage[]
  loginSessions      LoginSession[]
  errorEvents        ErrorEvent[]
  announcementsRead  AnnouncementRead[]
  
  // KYC Relations
  kycRequest         KycRequest?
  kycReviews         KycReview[]
  kycDocumentVerifications KycDocument[] @relation("KycDocumentVerifier")
  kycReviewedRequests KycRequest[] @relation("KycReviewer")
  
  // Custom Role Relation
  customRole         CustomRole?         @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([deletedAt])
  @@index([customRoleId])
}

model CustomRole {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  permissions RolePermission[]
  
  @@index([name])
}

model RolePermission {
  id          String   @id @default(cuid())
  roleId      String
  permission  String
  
  role        CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permission])
  @@index([roleId])
  @@index([permission])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @default("user")
  actorId    String?
  action     String
  category   String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
}

model Profile {
  userId      String    @id
  bio         String?
  country     String?
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  currency    String?   @default("USD")
  referredBy  String?
  coins       Int       @default(2500)
  gems        Int       @default(45)
  xp          Int       @default(0)
  level       Int       @default(1)
  wins        Int       @default(0)
  losses      Int       @default(0)
  draws       Int       @default(0)
  
  streetAddress String?
  city          String?
  state         String?
  postcode      String?
  
  emailVerified Boolean @default(false)
  kycStatus     String  @default("pending")
  
  passwordHash    String?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)

  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referredBy])
}

model Friend {
  id          String       @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Room {
  id         String     @id @default(uuid())
  code       String     @unique
  gameId     String
  hostId     String
  status     RoomStatus @default(WAITING)
  isPrivate  Boolean    @default(false)
  stake      Int
  minPlayers Int
  maxPlayers Int
  settings   Json       @default("{}")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  host         User          @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  players      RoomPlayer[]
  chatMessages ChatMessage[]
  match        Match?

  @@index([code])
  @@index([gameId, status])
}

model RoomPlayer {
  id               String           @id @default(uuid())
  roomId           String
  userId           String
  seat             Int?
  isReady          Boolean          @default(false)
  isHost           Boolean          @default(false)
  isSpectator      Boolean          @default(false)
  connectionStatus ConnectionStatus @default(CONNECTED)
  joinedAt         DateTime         @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Match {
  id        String      @id @default(uuid())
  roomId    String?     @unique
  gameId    String
  status    MatchStatus @default(CREATED)
  winnerIds Json        @default("[]")
  stake     Int         @default(0)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime    @default(now())
  
  room      Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  players   MatchPlayer[]
  moves     Move[]
  gameState GameState?
  replay    Replay?
  stats     MatchStatistics?
  
  @@index([gameId, status])
}

model MatchStatistics {
  id                  String    @id @default(uuid())
  matchId             String    @unique
  
  durationSeconds     Int       @default(0)
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  
  averagePing         Json      @default("{}")
  packetLoss          Json      @default("{}")
  reconnections       Int       @default(0)
  
  totalMoves          Int       @default(0)
  illegalMoveAttempts Int       @default(0)
  timeoutCount        Int       @default(0)
  drawOffers          Int       @default(0)
  rematchRequests     Int       @default(0)
  
  performanceData     Json      @default("{}")
  
  suspiciousActivity  Json      @default("[]")
  afkWarnings         Int       @default(0)
  
  spectatorPeak       Int       @default(0)
  spectatorMinutes    Int       @default(0)
  
  coinsAwarded        Json      @default("{}")
  xpAwarded           Json      @default("{}")
  ratingChanges       Json      @default("{}")
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  match               Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MatchPlayer {
  id           String            @id @default(uuid())
  matchId      String
  userId       String
  seat         Int
  result       MatchPlayerResult @default(PENDING)
  score        Int               @default(0)
  ratingBefore Int?
  ratingAfter  Int?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model GameState {
  id         String   @id @default(uuid())
  matchId    String   @unique
  state      Json
  turnNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Move {
  id         String   @id @default(uuid())
  matchId    String
  userId     String
  seat       Int
  turnNumber Int
  action     Json
  appliedAt  DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model Leaderboard {
  id          String   @id @default(uuid())
  gameId      String
  userId      String
  score       Int      @default(0)
  wins        Int      @default(0)
  gamesPlayed Int      @default(0)
  winRate     Float    @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId, score(sort: Desc)])
}

model Wallet {
  userId          String   @id
  balance         Int      @default(2500)
  bonusBalance    Int      @default(0)
  lockedBalance   Int      @default(0)
  rewardBalance   Int      @default(0)
  cashbackBalance Int      @default(0)
  isFrozen        Boolean  @default(false)
  frozenAt        DateTime?
  frozenReason    String?
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A user-initiated deposit or withdrawal that an admin approves or rejects.
/// Approving a deposit credits MAIN; approving a withdrawal debits MAIN. All
/// money movement happens inside a serializable transaction that locks both the
/// request and wallet rows so concurrent decisions cannot double-spend.
model WalletRequest {
  id         String              @id @default(uuid())
  userId     String
  kind       WalletRequestKind
  amount     Int
  fee        Int                 @default(0)
  status     WalletRequestStatus @default(PENDING)
  /// Payment provider label for deposits (e.g. "MANUAL", "STRIPE", "COUPON").
  method     String?
  /// Free-form note supplied by the user when creating the request.
  note       String?
  adminId    String?
  adminNote  String?
  decidedAt  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin User? @relation("WalletRequestAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId, kind, createdAt])
  @@index([kind, status, createdAt])
  @@index([status, createdAt])
}

/// One-time codes guarding sensitive wallet actions (withdrawals). Codes are
/// stored hashed, expire, and are single-use; attempts are bounded per code.
model WalletOtp {
  id         String   @id @default(uuid())
  userId     String
  purpose    String   @default("WALLET_WITHDRAWAL")
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model Transaction {
  id            String                   @id @default(uuid())
  userId        String
  type          TransactionType
  amount        Int
  balanceAfter  Int
  walletType    String                   @default("MAIN")
  referenceType TransactionReferenceType
  referenceId   String?
  meta          Json                     @default("{}")
  createdAt     DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([referenceType, createdAt])
}

model AppNotification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model ChatMessage {
  id         String   @id @default(uuid())
  roomId     String
  userId     String?
  senderName String
  body       String
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model Replay {
  id        String   @id @default(uuid())
  matchId   String   @unique
  gameId    String
  fileUrl   String?
  payload   Json?
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String
  icon        String
  gameId      String?
  xpReward    Int     @default(0)
  condition   Json?

  userAchievements UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model PlayerStatistic {
  id          String   @id @default(uuid())
  userId      String
  gameId      String
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  bestScore   Int      @default(0)
  totalXp     Int      @default(0)
  rating      Int      @default(1000)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, rating(sort: Desc)])
}

model PlayerGameStats {
  id                  String    @id @default(uuid())
  userId              String
  gameId              String
  
  totalMatches        Int       @default(0)
  rankedMatches       Int       @default(0)
  casualMatches       Int       @default(0)
  
  wins                Int       @default(0)
  losses              Int       @default(0)
  draws               Int       @default(0)
  winRate             Float     @default(0)
  
  currentWinStreak    Int       @default(0)
  longestWinStreak    Int       @default(0)
  currentLossStreak   Int       @default(0)
  longestLossStreak   Int       @default(0)
  
  averageMatchDuration Int      @default(0)
  fastestWin          Int?
  bestPerformance     Json?
  
  totalTimePlayed     Int       @default(0)
  rankedTimePlayed    Int       @default(0)
  casualTimePlayed    Int       @default(0)
  
  lastTenMatches      Json      @default("[]")
  lastTwentyMatches   Json      @default("[]")
  
  lastMatchAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, gameId])
  @@index([gameId, winRate(sort: Desc)])
  @@index([gameId, totalMatches(sort: Desc)])
}

model CompetitiveRank {
  id                String      @id @default(uuid())
  userId            String
  gameId            String
  seasonId          String?
  
  mmr               Int         @default(1000)
  rating            Int         @default(1000)
  peakRating        Int         @default(1000)
  
  tier              RankTier    @default(BRONZE)
  tierProgress      Int         @default(0)
  stars             Int         @default(0)
  
  placementMatches  Int         @default(0)
  placementComplete Boolean     @default(false)
  promotionMatches  Int         @default(0)
  demotionProtection Boolean    @default(false)
  
  gamesPlayed       Int         @default(0)
  wins              Int         @default(0)
  losses            Int         @default(0)
  draws             Int         @default(0)
  winStreak         Int         @default(0)
  longestWinStreak  Int         @default(0)
  
  globalRank        Int?
  regionalRank      Int?
  countryRank       Int?
  
  lastMatchAt       DateTime?
  ratingUpdatedAt   DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  season            Season?     @relation(fields: [seasonId], references: [id])
  history           RatingHistory[]
  
  @@unique([userId, gameId, seasonId])
  @@index([gameId, mmr(sort: Desc)])
  @@index([gameId, rating(sort: Desc)])
  @@index([gameId, tier])
}

model Season {
  id                String        @id @default(uuid())
  gameId            String
  name              String
  startDate         DateTime
  endDate           DateTime
  status            SeasonStatus  @default(UPCOMING)
  rewards           Json          @default("{}")
  createdAt         DateTime      @default(now())
  
  ranks             CompetitiveRank[]
  history           RatingHistory[]
  
  @@unique([gameId, startDate])
  @@index([gameId, status])
}

model RatingHistory {
  id                    String   @id @default(uuid())
  rankId                String
  seasonId              String?
  matchId               String?
  
  ratingBefore          Int
  ratingAfter           Int
  ratingChange          Int
  mmrBefore             Int
  mmrAfter              Int
  mmrChange             Int
  
  tierBefore            RankTier
  tierAfter             RankTier
  tierProgressBefore    Int
  tierProgressAfter     Int
  
  opponentRating        Int?
  result                String
  gameId                String
  
  createdAt             DateTime @default(now())
  
  rank                  CompetitiveRank @relation(fields: [rankId], references: [id], onDelete: Cascade)
  season                Season?  @relation(fields: [seasonId], references: [id])
  
  @@index([rankId, createdAt(sort: Desc)])
  @@index([matchId])
}

model PlayerPenalty {
  id                String        @id @default(uuid())
  userId            String
  matchId           String?
  
  type              PenaltyType
  severity          Int           @default(1)
  status            PenaltyStatus @default(ACTIVE)
  
  duration          Int           @default(0)
  startedAt         DateTime      @default(now())
  expiresAt         DateTime?
  
  coinsPenalty      Int           @default(0)
  xpPenalty        Int           @default(0)
  ratingPenalty     Int           @default(0)
  
  detectionMethod   String        @default("automatic")
  detectionData     Json?
  
  appealedAt        DateTime?
  appealReason      String?
  appealResolvedAt  DateTime?
  appealStatus      String?
  
  issuedBy          String?
  reason            String
  notes             String?
  
  createdAt         DateTime      @default(now())
  
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, status, expiresAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([matchId])
}

model PlayerReputation {
  id                  String    @id @default(uuid())
  userId              String    @unique
  
  score               Float     @default(100.0)
  tier                String    @default("Good")
  
  reportsReceived     Int       @default(0)
  reportsValidated    Int       @default(0)
  complimentsReceived Int       @default(0)
  
  afkCount            Int       @default(0)
  rageQuitCount       Int       @default(0)
  sportsmanshipScore  Float     @default(100.0)
  
  gamesCompleted      Int       @default(0)
  gamesAbandoned      Int       @default(0)
  completionRate      Float     @default(100.0)
  
  monthlyScore        Float     @default(100.0)
  weeklyScore         Float     @default(100.0)
  
  lastUpdated         DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([score(sort: Desc)])
}

model PlayerReport {
  id              String    @id @default(uuid())
  reporterId      String
  reportedUserId  String
  matchId         String?
  
  reason          String
  category        String
  description     String?
  evidence        Json?
  
  status          String    @default("pending")
  reviewedBy      String?
  reviewedAt      DateTime?
  resolution      String?
  action          String?
  
  contextData     Json?
  
  createdAt       DateTime  @default(now())
  
  reporter        User      @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User      @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  
  @@index([status, createdAt(sort: Desc)])
  @@index([reportedUserId, status])
}

model GameNotification {
  id          String              @id @default(uuid())
  userId      String
  type        GameNotificationType
  
  title       String
  body        String
  data        Json?
  
  readAt      DateTime?
  dismissedAt DateTime?
  actionUrl   String?
  
  expiresAt   DateTime?
  
  createdAt   DateTime            @default(now())
  
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

model Tournament {
  id          String           @id @default(uuid())
  gameId      String
  title       String
  description String
  bannerUrl   String?
  format      TournamentFormat @default(BRACKET)
  prizePool   Int              @default(0)
  entryFee    Int              @default(0)
  maxPlayers  Int              @default(8)
  startTime   DateTime
  endTime     DateTime?
  rules       Json             @default("{}")
  status      TournamentStatus @default(UPCOMING)
  createdBy   String?
  createdAt   DateTime         @default(now())

  players TournamentPlayer[]
  rounds  TournamentRound[]

  @@index([status, startTime])
}

model TournamentPlayer {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  nickname     String?
  registeredAt DateTime @default(now())
  seed         Int?
  result       Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model TournamentRound {
  id           String  @id @default(uuid())
  tournamentId String
  roundNumber  Int
  playerAId    String
  playerBId    String
  winnerId     String?
  matchId      String?
  playerAScore Int     @default(0)
  playerBScore Int     @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, roundNumber, playerAId, playerBId])
}

model Referral {
  id             String   @id @default(uuid())
  code           String
  referrerId     String
  referredUserId String   @unique
  status         String   @default("PENDING")
  commission     Int      @default(0)
  createdAt      DateTime @default(now())

  referrer     User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique
  title          String
  description    String?
  discountType   CouponDiscountType
  discountValue  Int
  maxUses        Int                @default(1)
  usedCount      Int                @default(0)
  minWager       Int                @default(0)
  maxRedeemValue Int?
  gameId         String?
  validFrom      DateTime
  validUntil     DateTime
  status         CouponStatus       @default(ACTIVE)
  createdBy      String?
  createdAt      DateTime           @default(now())

  redemptions CouponRedemption[]

  @@index([status, validUntil])
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId, createdAt])
}

model Announcement {
  id         String           @id @default(uuid())
  title      String
  body       String
  type       AnnouncementType @default(INFO)
  imageUrl   String?
  targetRole String?          @default("ALL")
  startsAt   DateTime?
  expiresAt  DateTime?
  createdBy  String?
  createdAt  DateTime         @default(now())

  reads AnnouncementRead[]

  @@index([type, createdAt])
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockingUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model SupportTicket {
  id         String         @id @default(uuid())
  userId     String
  subject    String
  category   String         @default("GENERAL")
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  assignedTo String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId, status])
  @@index([status, priority])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model LoginSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  deviceName String?
  isCurrent  Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  query     String
  type      String   @default("GLOBAL")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ErrorEvent {
  id         String        @id @default(uuid())
  code       String
  message    String
  stack      String?
  severity   ErrorSeverity @default(MEDIUM)
  status     ErrorStatus   @default(OPEN)
  source     String?
  path       String?
  method     String?
  userId     String?
  ip         String?
  userAgent  String?
  meta       Json?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([code, createdAt])
}

model CronJobRun {
  id         String        @id @default(uuid())
  jobName    String
  status     CronJobStatus
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?
  meta       Json?

  @@index([jobName, startedAt])
}

model SiteSetting {
  /// Dotted key, e.g. `general.siteName`, `auth.signupEnabled`.
  key       String   @id
  /// Top-level category, derived from the key prefix. Indexed for fast filtering.
  category  String
  /// JSON-encoded value (validated against the shared settings schema).
  value     Json
  /// True for sensitive values (secrets/keys) never returned by /api/settings.
  secret    Boolean  @default(false)
  /// Last editor (admin user id). Null for seeded defaults.
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ============================================================================
// Support Assistant Models
// ============================================================================

enum SupportContentType {
  FAQ
  QUICK_ACTION
  GUIDE
  TROUBLESHOOTING
  NOTE
  LINK
  TUTORIAL
}

enum SupportContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SupportCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles SupportArticle[]

  @@index([isActive, sortOrder])
}

model SupportArticle {
  id           String               @id @default(cuid())
  categoryId   String
  title        String
  slug         String               @unique
  content      String
  contentType  SupportContentType   @default(FAQ)
  status       SupportContentStatus @default(DRAFT)
  tags         String[]             @default([])
  keywords     String[]             @default([])
  quickAction  Json?                // { label: string, action: string, link?: string }
  sortOrder    Int                  @default(0)
  viewCount    Int                  @default(0)
  helpfulCount Int                  @default(0)
  notHelpfulCount Int               @default(0)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  category SupportCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  mappings SupportPageMapping[]
  feedback SupportArticleFeedback[]

  @@index([categoryId, status, sortOrder])
  @@index([contentType, status])
  @@index([tags])
  @@index([status, createdAt])
}

model SupportPageMapping {
  id        String   @id @default(cuid())
  articleId String
  pageRoute String   // e.g., "/wallet", "/games/chess"
  context   String?  // Additional context for filtering
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  article SupportArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, pageRoute])
  @@index([pageRoute, isActive, priority])
}

model SupportArticleFeedback {
  id        String   @id @default(cuid())
  articleId String
  userId    String?
  isHelpful Boolean
  feedback  String?
  pageRoute String?
  createdAt DateTime @default(now())

  article SupportArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([userId])
}

model SupportArticleTranslation {
  id          String   @id @default(cuid())
  articleId   String
  language    String   // e.g., "en", "es", "fr"
  title       String
  content     String
  keywords    String[] @default([])
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([articleId, language])
  @@index([articleId, language])
}

model SupportSearchLog {
  id         String    @id @default(cuid())
  query      String
  userId     String?
  pageRoute  String?
  results    Json?     // Array of matched article IDs
  clickedId  String?   // Article ID that was clicked
  createdAt  DateTime  @default(now())

  @@index([query])
  @@index([userId, createdAt])
  @@index([pageRoute, createdAt])
}

// ==================== KYC VERIFICATION SYSTEM ====================

enum KycLevel {
  LEVEL_0  // Unverified
  LEVEL_1  // Basic Verification
  LEVEL_2  // Identity Verification  
  LEVEL_3  // Address Verification
}

enum KycStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  REQUIRES_RESUBMISSION
}

enum KycDocumentType {
  // India
  AADHAAR_CARD
  PAN_CARD
  VOTER_ID
  // International
  PASSPORT
  DRIVING_LICENCE
  NATIONAL_ID
  RESIDENCE_PERMIT
  // Address Proof
  UTILITY_BILL
  BANK_STATEMENT
  GOVERNMENT_ADDRESS_DOC
}

enum KycDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model KycRequest {
  id           String      @id @default(cuid())
  userId       String      @unique
  level        KycLevel    @default(LEVEL_0)
  status       KycStatus   @default(NOT_STARTED)
  country      String?
  
  // Level 1 fields
  fullName     String?
  dateOfBirth  DateTime?
  mobileNumber String?
  
  // Review fields
  reviewedBy   String?
  reviewedAt   DateTime?
  rejectionReason String?
  
  // Administrative Override
  adminOverride    Boolean   @default(false)
  adminOverrideBy  String?
  adminOverrideAt  DateTime?
  adminOverrideReason String?
  
  submittedAt DateTime?
  approvedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?       @relation("KycReviewer", fields: [reviewedBy], references: [id])
  documents   KycDocument[]
  reviews     KycReview[]
  auditLogs   KycAuditLog[]
  
  @@index([status])
  @@index([level])
  @@index([country])
  @@index([createdAt])
}

model KycDocument {
  id            String            @id @default(cuid())
  requestId     String
  documentType  KycDocumentType
  status        KycDocumentStatus @default(PENDING)
  
  // File metadata
  fileName      String
  fileUrl       String            // Encrypted path
  fileSize      Int               // in bytes
  mimeType      String
  fileHash      String            // SHA-256 hash for integrity
  
  // Page/side indicator (for documents with front/back)
  page          Int?              // 0 = front, 1 = back
  side          String?           // "front", "back"
  
  // Document-specific fields
  documentNumber String?
  issueDate     DateTime?
  expiryDate    DateTime?
  issuingCountry String?
  
  // Selfie verification
  isSelfie      Boolean  @default(false)
  
  // Review
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  request     KycRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  verifier    User?      @relation("KycDocumentVerifier", fields: [verifiedBy], references: [id])
  
  @@index([requestId])
  @@index([documentType])
  @@index([status])
}

model KycReview {
  id          String   @id @default(cuid())
  requestId   String
  reviewerId  String
  action      String   // APPROVED, REJECTED, REQUEST_RESUBMISSION, INFO_UPDATED
  notes       String?
  metadata    Json?
  createdAt   DateTime @default(now())
  
  request     KycRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewer    User       @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  
  @@index([requestId, createdAt])
  @@index([reviewerId, createdAt])
}

model KycAuditLog {
  id          String   @id @default(cuid())
  requestId   String
  actorId     String?
  action      String
  category    String   // "STATUS_CHANGE", "DOCUMENT_UPLOAD", "REVIEW", "ADMIN_OVERRIDE"
  targetType  String?
  targetId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  request     KycRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  @@index([requestId, createdAt])
  @@index([action, createdAt])
}

model KycWithdrawalLimit {
  id              String   @id @default(cuid())
  level           KycLevel @unique
  dailyLimit      Int      // in cents
  monthlyLimit    Int      // in cents
  singleWithdrawLimit Int  // in cents
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([level, isActive])
}

model KycDocumentConfig {
  id              String   @id @default(cuid())
  country         String
  documentType    KycDocumentType
  isAccepted     Boolean  @default(true)
  isRequired     Boolean  @default(false)
  requiresBack   Boolean  @default(false)  // Document has front/back
  hasExpiry      Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([country, documentType])
  @@index([country, isAccepted])
}
