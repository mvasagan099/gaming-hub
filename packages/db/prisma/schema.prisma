/// Singleton config for Android app version enforcement.
/// An admin can configure the minimum supported version; any Android client
/// below that version receives a hard lock screen until they update.
model AppVersionConfig {
  id                      String   @id @default(cuid())
  /// Latest released Android version string (e.g. "1.2.0"). Informational — shown on the update screen.
  latestVersion           String   @default("1.0")
  /// Minimum version still allowed to use the app. Android clients below this → full hard lock.
  minimumSupportedVersion String   @default("1.0")
  /// Direct APK / Play Store URL opened when the user taps "UPDATE NOW".
  downloadUrl             String   @default("https://play.google.com/store/apps/details?id=com.gaminghub.app")
  /// Message shown on the hard-lock update screen.
  updateMessage           String   @default("A new version of Gaming Hub is required. Please update to continue playing.")
  /// When true, force the update prompt (even for users at or above minimumSupportedVersion).
  forceUpdate             Boolean  @default(false)
  updatedAt               DateTime @updatedAt
  /// Admin user ID who last changed the config.
  updatedBy               String?
}

/// MEDIUM-2 fix: Durable store for anti-cheat security events.
/// The in-memory buffer in adminAntiCheat.ts is now backed by this table so
/// events survive server restarts, crashes, and rolling deployments.
model SecurityEvent {
  id           String   @id @default(cuid())
  matchId      String?
  roomId       String?
  userId       String
  gameId       String?
  eventType    String
  severity     String
  details      Json     @default("{}")
  actionTaken  String   @default("LOG")
  /// Unix millisecond timestamp (preserved from the in-memory record format).
  timestamp    BigInt
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([severity, createdAt])
  @@index([eventType, createdAt])
  @@index([matchId])
}

// Shared, fixed-window security budgets. Keys are SHA-256 digests, never tokens/PII.
model RateLimitWindow {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
