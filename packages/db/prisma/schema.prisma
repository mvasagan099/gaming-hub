generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum RoomStatus {
  WAITING
  STARTING
  PLAYING
  ENDED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  RECONNECTING
}

enum MatchStatus {
  CREATED
  ACTIVE
  FINISHED
  ABORTED
}

enum MatchPlayerResult {
  PENDING
  WIN
  LOSS
  DRAW
}

enum TransactionType {
  CREDIT
  DEBIT
  ADJUST
}

enum TransactionReferenceType {
  MATCH_WAGER
  MATCH_PAYOUT
  ADMIN
  BONUS
  PRACTICE
  DEPOSIT
  WITHDRAWAL
  REFERRAL
  COUPON
  TOURNAMENT_ENTRY
  TOURNAMENT_PRIZE
  LOCKED_CREDIT
  REWARD_CREDIT
  CASHBACK_CREDIT
  WAGER_REFUND
  REVERSAL
}

enum NotificationType {
  MATCH_INVITE
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  MATCH_RESULT
  TOURNAMENT
  SYSTEM
  REFERRAL
  COUPON
  ANNOUNCEMENT
  MESSAGE
  SUPPORT
  PROMOTION
  WALLET
  ACHIEVEMENT
  SYSTEM_ALERT
}

enum TournamentStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

enum TournamentFormat {
  BRACKET
  KNOCKOUT
  ROUND_ROBIN
  SWISS
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum AnnouncementType {
  INFO
  UPDATE
  MAINTENANCE
  PROMOTION
  ALERT
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CronJobStatus {
  SUCCESS
  FAILED
  RUNNING
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  IGNORED
}

model User {
  id           String    @id
  email        String?   @unique
  username     String    @unique
  displayName  String
  avatarUrl    String?
  role         UserRole  @default(USER)
  referralCode String?   @unique
  isOnline     Boolean   @default(false)
  lastSeenAt   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile            Profile?
  wallet             Wallet?
  playerStatistics   PlayerStatistic[]
  leaderboards       Leaderboard[]
  friendsRequested   Friend[]             @relation("FriendRequester")
  friendsReceived    Friend[]             @relation("FriendAddressee")
  blockedBy          BlockedUser[]        @relation("BlockedBy")
  blocking           BlockedUser[]        @relation("BlockingUser")
  roomsOwned         Room[]               @relation("RoomHost")
  roomPlayers        RoomPlayer[]
  matchPlayers       MatchPlayer[]
  moves              Move[]
  walletTransactions Transaction[]
  notifications      AppNotification[]
  chatMessages       ChatMessage[]
  userAchievements   UserAchievement[]
  tournamentPlayers  TournamentPlayer[]
  referralsMade      Referral[]           @relation("Referrer")
  referralsReceived  Referral[]           @relation("ReferredUser")
  couponRedemptions  CouponRedemption[]
  conversations      ConversationMember[]
  sentMessages       Message[]
  searchHistory      SearchHistory[]
  supportTickets     SupportTicket[]
  ticketMessages     TicketMessage[]
  loginSessions      LoginSession[]
  errorEvents        ErrorEvent[]
  announcementsRead  AnnouncementRead[]

  @@index([role])
  @@index([deletedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String   @default("user")
  actorId    String?
  action     String
  category   String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
}

model Profile {
  userId      String    @id
  bio         String?
  country     String?
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  currency    String?   @default("USD")
  referredBy  String?
  coins       Int       @default(2500)
  gems        Int       @default(45)
  xp          Int       @default(0)
  level       Int       @default(1)
  wins        Int       @default(0)
  losses      Int       @default(0)
  draws       Int       @default(0)

  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referredBy])
}

model Friend {
  id          String       @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Room {
  id         String     @id @default(uuid())
  code       String     @unique
  gameId     String
  hostId     String
  status     RoomStatus @default(WAITING)
  isPrivate  Boolean    @default(false)
  stake      Int
  minPlayers Int
  maxPlayers Int
  settings   Json       @default("{}")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  host         User          @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  players      RoomPlayer[]
  chatMessages ChatMessage[]
  match        Match?

  @@index([code])
  @@index([gameId, status])
}

model RoomPlayer {
  id               String           @id @default(uuid())
  roomId           String
  userId           String
  seat             Int?
  isReady          Boolean          @default(false)
  isHost           Boolean          @default(false)
  isSpectator      Boolean          @default(false)
  connectionStatus ConnectionStatus @default(CONNECTED)
  joinedAt         DateTime         @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Match {
  id        String      @id @default(uuid())
  roomId    String?     @unique
  gameId    String
  status    MatchStatus @default(CREATED)
  winnerIds Json        @default("[]")
  stake     Int         @default(0)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime    @default(now())

  room      Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  players   MatchPlayer[]
  moves     Move[]
  gameState GameState?
  replay    Replay?

  @@index([gameId, status])
}

model MatchPlayer {
  id           String            @id @default(uuid())
  matchId      String
  userId       String
  seat         Int
  result       MatchPlayerResult @default(PENDING)
  score        Int               @default(0)
  ratingBefore Int?
  ratingAfter  Int?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model GameState {
  id         String   @id @default(uuid())
  matchId    String   @unique
  state      Json
  turnNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Move {
  id         String   @id @default(uuid())
  matchId    String
  userId     String
  seat       Int
  turnNumber Int
  action     Json
  appliedAt  DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model Leaderboard {
  id          String   @id @default(uuid())
  gameId      String
  userId      String
  score       Int      @default(0)
  wins        Int      @default(0)
  gamesPlayed Int      @default(0)
  winRate     Float    @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId, score(sort: Desc)])
}

model Wallet {
  userId          String   @id
  balance         Int      @default(2500)
  bonusBalance    Int      @default(0)
  lockedBalance   Int      @default(0)
  rewardBalance   Int      @default(0)
  cashbackBalance Int      @default(0)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String                   @id @default(uuid())
  userId        String
  type          TransactionType
  amount        Int
  balanceAfter  Int
  walletType    String                   @default("MAIN")
  referenceType TransactionReferenceType
  referenceId   String?
  meta          Json                     @default("{}")
  createdAt     DateTime                 @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([referenceType, createdAt])
}

model AppNotification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model ChatMessage {
  id         String   @id @default(uuid())
  roomId     String
  userId     String?
  senderName String
  body       String
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  room Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

model Replay {
  id        String   @id @default(uuid())
  matchId   String   @unique
  gameId    String
  fileUrl   String?
  payload   Json?
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String
  icon        String
  gameId      String?
  xpReward    Int     @default(0)
  condition   Json?

  userAchievements UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model PlayerStatistic {
  id          String   @id @default(uuid())
  userId      String
  gameId      String
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  bestScore   Int      @default(0)
  totalXp     Int      @default(0)
  rating      Int      @default(1000)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, rating(sort: Desc)])
}

model Tournament {
  id          String           @id @default(uuid())
  gameId      String
  title       String
  description String
  bannerUrl   String?
  format      TournamentFormat @default(BRACKET)
  prizePool   Int              @default(0)
  entryFee    Int              @default(0)
  maxPlayers  Int              @default(8)
  startTime   DateTime
  endTime     DateTime?
  rules       Json             @default("{}")
  status      TournamentStatus @default(UPCOMING)
  createdBy   String?
  createdAt   DateTime         @default(now())

  players TournamentPlayer[]
  rounds  TournamentRound[]

  @@index([status, startTime])
}

model TournamentPlayer {
  id           String   @id @default(uuid())
  tournamentId String
  userId       String
  nickname     String?
  registeredAt DateTime @default(now())
  seed         Int?
  result       Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model TournamentRound {
  id           String  @id @default(uuid())
  tournamentId String
  roundNumber  Int
  playerAId    String
  playerBId    String
  winnerId     String?
  matchId      String?
  playerAScore Int     @default(0)
  playerBScore Int     @default(0)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, roundNumber, playerAId, playerBId])
}

model Referral {
  id             String   @id @default(uuid())
  code           String
  referrerId     String
  referredUserId String   @unique
  status         String   @default("PENDING")
  commission     Int      @default(0)
  createdAt      DateTime @default(now())

  referrer     User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique
  title          String
  description    String?
  discountType   CouponDiscountType
  discountValue  Int
  maxUses        Int                @default(1)
  usedCount      Int                @default(0)
  minWager       Int                @default(0)
  maxRedeemValue Int?
  gameId         String?
  validFrom      DateTime
  validUntil     DateTime
  status         CouponStatus       @default(ACTIVE)
  createdBy      String?
  createdAt      DateTime           @default(now())

  redemptions CouponRedemption[]

  @@index([status, validUntil])
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  value     Int
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId, createdAt])
}

model Announcement {
  id         String           @id @default(uuid())
  title      String
  body       String
  type       AnnouncementType @default(INFO)
  imageUrl   String?
  targetRole String?          @default("ALL")
  startsAt   DateTime?
  expiresAt  DateTime?
  createdBy  String?
  createdAt  DateTime         @default(now())

  reads AnnouncementRead[]

  @@index([type, createdAt])
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockingUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model SupportTicket {
  id         String         @id @default(uuid())
  userId     String
  subject    String
  category   String         @default("GENERAL")
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  assignedTo String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([userId, status])
  @@index([status, priority])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  body      String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model LoginSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  deviceName String?
  isCurrent  Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  query     String
  type      String   @default("GLOBAL")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ErrorEvent {
  id         String        @id @default(uuid())
  code       String
  message    String
  stack      String?
  severity   ErrorSeverity @default(MEDIUM)
  status     ErrorStatus   @default(OPEN)
  source     String?
  path       String?
  method     String?
  userId     String?
  ip         String?
  userAgent  String?
  meta       Json?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([code, createdAt])
}

model CronJobRun {
  id         String        @id @default(uuid())
  jobName    String
  status     CronJobStatus
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?
  meta       Json?

  @@index([jobName, startedAt])
}

model SiteSetting {
  /// Dotted key, e.g. `general.siteName`, `auth.signupEnabled`.
  key       String   @id
  /// Top-level category, derived from the key prefix. Indexed for fast filtering.
  category  String
  /// JSON-encoded value (validated against the shared settings schema).
  value     Json
  /// True for sensitive values (secrets/keys) never returned by /api/settings.
  secret    Boolean  @default(false)
  /// Last editor (admin user id). Null for seeded defaults.
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@index([category])
}
