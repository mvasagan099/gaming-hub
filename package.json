{
  "name": "gaming-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run db:generate && npm run build -w @gaming-hub/multiplayer",
    "dev": "concurrently -n web,api,socket -c cyan,magenta,yellow \"npm run dev -w @gaming-hub/web\" \"npm run dev -w @gaming-hub/api\" \"npm run dev -w @gaming-hub/socket-server\"",
    "dev:web": "npm run dev -w @gaming-hub/web",
    "dev:api": "npm run dev -w @gaming-hub/api",
    "dev:socket": "npm run dev -w @gaming-hub/socket-server",
    "build": "npm run build -w @gaming-hub/multiplayer && npm run build -w @gaming-hub/web && npm run build -w @gaming-hub/api && npm run build -w @gaming-hub/socket-server",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "npm run lint -w @gaming-hub/web --if-present",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:backup": "tsx scripts/db-backup.mts",
    "db:restore": "tsx scripts/db-restore.mts",
    "db:seed:support": "tsx scripts/seed-support.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "cap:sync": "npm run cap:sync -w @gaming-hub/web",
    "cap:open": "npm run cap:open -w @gaming-hub/web",
    "cap:build": "npm run cap:build -w @gaming-hub/web",
    "cap:sync:ios": "npm run cap:sync:ios -w @gaming-hub/web",
    "cap:open:ios": "npm run cap:open:ios -w @gaming-hub/web",
    "cap:build:ios": "npm run cap:build:ios -w @gaming-hub/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "loupe": "^3.2.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "tsup": {
      "esbuild": "0.28.1"
    },
    "deepmerge-ts": "8.0.0",
    "brace-expansion@^5.0.0": "5.0.12",
    "brace-expansion@^1.0.0": "1.1.21",
    "fast-uri@^3.0.0": "3.1.8",
    "fast-uri@^4.0.0": "4.1.5",
    "xcode": {
      "uuid": "11.1.1"
    },
    "qs": "6.16.0"
  },
  "dependencies": {
    "@capacitor/ios": "^8.5.1"
  }
}
