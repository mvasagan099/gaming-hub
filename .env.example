# Shared configuration example. Never commit real secrets.
# Copy to `.env` and fill in real values.

# --- Supabase (auth backend) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Service-role secret: server-side admin operations ONLY (creating users in smoke tests, etc.)
SUPABASE_SECRET_KEY=your-secret-key

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/gaming_hub

# --- Service-to-service ---
# Shared secret that authenticates the socket server against the API's internal endpoints.
# Must be identical in apps/api/.env and apps/socket-server/.env. Minimum 8 chars.
INTERNAL_API_KEY=generate-a-long-random-secret

# --- CouponVault Integration ---
COUPON_API_URL=http://127.0.0.1:4000/api/v1
COUPON_API_KEY=your-32-char-min-coupon-vault-api-key
